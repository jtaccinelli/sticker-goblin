
{% doc %}
  Renders the artist headshot image.
  @param {image} artist_headshot - The artist's headshot image
  @param {string} artist_name - The artist's name, used as image alt text
{% enddoc %}

{%- assign headshot_size = block.settings.size | append: 'px' -%}

<div
  class="featured-artist__headshot"
  style="--headshot-size: {{ block.settings.size }}px; --headshot-radius: {{ block.settings.border_radius }}px;"
>
  {{
    artist_headshot
    | image_url: width: 200
    | image_tag:
      alt: artist_name,
      loading: 'lazy',
      widths: '60, 80, 100, 120',
      sizes: headshot_size
  }}
</div>

{% stylesheet %}
  .featured-artist__headshot {
    flex-shrink: 0;
    width: var(--headshot-size, 60px);
    height: var(--headshot-size, 60px);
    border-radius: var(--headshot-radius, var(--border-radius-md, 8px));
    overflow: hidden;
  }

  .featured-artist__headshot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_featured_artist_headshot",
  "settings": [
    {
      "type": "range",
      "id": "size",
      "label": "t:settings.size",
      "min": 40,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ]
}
{% endschema %}
